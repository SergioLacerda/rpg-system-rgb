{
  "schema": "rgb-docs-consumer-contracts/0.1",
  "source_index": "docs/core/semantic/core-v2.index.json",
  "description": "Public AI-first documentation consumer contracts for Core, Maker, Specialist, tooling, Library, PDF, landing, and bundles.",
  "contracts": [
    {
      "id": "consumer.core.v0_1",
      "component": "Core",
      "status": "proposed",
      "description": "Core owns the canonical rules surface during the bridge and may later promote accepted semantic source units through an ADR.",
      "allowed_inputs": [
        "canonical_markdown_bridge",
        "canonical_semantic",
        "translation",
        "design_record"
      ],
      "required_unit_fields": [
        "id",
        "kind",
        "locale",
        "authority_type",
        "source_status",
        "title",
        "source_path",
        "projection_paths",
        "relationships",
        "index",
        "provenance",
        "component_consumers"
      ],
      "allowed_projection_surfaces": [
        "markdown_en",
        "markdown_pt_br",
        "search_index"
      ],
      "forbidden_authority_types": [
        "generated_artifact"
      ],
      "required_disclosures": [
        "draft",
        "stale",
        "needs_review",
        "missing",
        "localized"
      ],
      "outputs": [
        "canonical markdown bridge updates",
        "future canonical semantic source units",
        "Core projection review notes"
      ],
      "validation_checks": [
        "source IDs exist",
        "canonical bridge units expose markdown_en",
        "translations declare source_unit and translation_status"
      ],
      "source_refs": [
        "docs/adr/adr-001-ai-first-documentation-authority.md",
        "docs/core/semantic/schema-v0.1.md"
      ]
    },
