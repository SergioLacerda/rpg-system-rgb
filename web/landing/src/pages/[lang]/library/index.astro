---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { dict, locales, type Locale } from "../../../i18n/dictionary";
import { landingPath } from "../../../lib/paths";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const nav = dict[lang].nav;
const href = landingPath("/library/");
---

<BaseLayout lang={lang} title={nav.library}>
  <meta http-equiv="refresh" content={`0; url=${href}`} />
  <section class="bridge">
    <h1>{nav.library}</h1>
    <p>
      <a href={href}>Open RGB System Library</a>
    </p>
  </section>
</BaseLayout>

<style>
  .bridge {
    min-height: 56vh;
    padding: 56px 48px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 32px;
    margin: 0 0 16px;
    color: var(--text);
  }
  a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 760px) {
    .bridge {
      padding: 42px 22px;
    }
  }
</style>
