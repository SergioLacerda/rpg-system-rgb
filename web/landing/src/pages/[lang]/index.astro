---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VectorCard from '../../components/VectorCard.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { dict, locales, type Locale } from '../../i18n/dictionary';
import { landingPath } from '../../lib/paths';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = dict[lang];
const pdfHref = landingPath(`/downloads/rgb-system-core-v2-latest-${lang}.pdf`);
---
<BaseLayout lang={lang} title={t.hero.title}>
  <section class="hero">
    <div class="kicker">{t.hero.kicker}</div>
    <h1>{t.hero.title}</h1>
    <p class="sub">{t.hero.sub}</p>
    <div class="ctas">
      <a class="primary" href={landingPath('/library/')}>{t.hero.ctaLibrary}</a>
      <a class="secondary" href={pdfHref}>{t.hero.ctaPdf}</a>
    </div>
    <svg width="220" height="200" viewBox="0 0 180 170" class="glyph">
      <polygon points="90,20 150,120 30,120" fill="none" stroke="var(--text)" stroke-width="1.5" opacity="0.5"></polygon>
      <line x1="90" y1="88" x2="140" y2="45" stroke="var(--r)" stroke-width="2"></line>
      <line x1="90" y1="88" x2="40" y2="45" stroke="var(--b)" stroke-width="2"></line>
      <line x1="90" y1="88" x2="90" y2="150" stroke="var(--g)" stroke-width="2"></line>
      <circle cx="90" cy="88" r="4" fill="var(--text)"></circle>
    </svg>
  </section>

  <section class="problem">
    <div class="kicker">{t.problem.kicker}</div>
    <h2>{t.problem.title}</h2>
    <ul>
      {t.problem.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="system">
    <div class="kicker">{t.system.kicker}</div>
    <h2>{t.system.title}</h2>
    <p class="sub">{t.system.desc}</p>
    <div class="vectors">
      {t.vectors.map((v) => <VectorCard code={v.code} label={v.label} title={v.title} desc={v.desc} />)}
    </div>
  </section>

  <section class="library">
    <div class="kicker">{t.libraryTeaser.kicker}</div>
    <h2>{t.libraryTeaser.title}</h2>
    <p class="sub">{t.libraryTeaser.desc}</p>
    <div class="library-grid">
      <div class="preview">
        <div class="preview-title">{t.libraryTeaser.previewTitle}</div>
        <p class="preview-desc">{t.libraryTeaser.previewDesc}</p>
      </div>
      <div class="library-ctas">
        <a class="primary" href={landingPath('/library/')}>{t.libraryTeaser.cta}</a>
        <a class="secondary" href={pdfHref}>{t.hero.ctaPdf}</a>
      </div>
    </div>
  </section>

  <section class="for-developers">
    <div class="kicker">{t.forDevelopers.kicker}</div>
    <h2>{t.forDevelopers.title}</h2>
    <p class="sub">{t.forDevelopers.desc}</p>
    <div class="dev-blocks">
      {t.forDevelopers.items.map((item) => <CodeBlock label={item.label} code={item.code} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 100px 40px 80px; background: radial-gradient(circle at 50% 20%, var(--surface) 0%, var(--bg) 60%); }
  .kicker { font-size: 12px; letter-spacing: 2px; color: var(--text-dim); margin-bottom: 20px; }
  h1 { font-family: var(--font-serif); font-size: 56px; color: var(--text); margin: 0 0 20px; line-height: 1.15; }
  .sub { font-size: 17px; color: var(--text-dim); max-width: 560px; margin: 0 auto 36px; line-height: 1.6; }
  .ctas { display: flex; gap: 14px; justify-content: center; margin-bottom: 60px; }
  .primary { background: var(--text); color: var(--bg); padding: 13px 26px; border-radius: 6px; font-size: 14px; font-weight: 600; }
  .secondary { border: 1px solid #2a3350; color: var(--text); padding: 13px 26px; border-radius: 6px; font-size: 14px; }
  .glyph { display: block; margin: 0 auto; }

  section.problem, section.system, section.library, section.for-developers {
    padding: 72px 40px;
    max-width: 920px;
    margin: 0 auto;
  }
  section.problem h2, section.system h2, section.library h2, section.for-developers h2 {
    font-family: var(--font-serif);
    font-size: 32px;
    color: var(--text);
    margin: 0 0 16px;
  }

  .problem ul { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
  .problem li { color: var(--text-dim); font-size: 15px; line-height: 1.6; padding-left: 22px; position: relative; }
  .problem li::before { content: '—'; position: absolute; left: 0; color: var(--r); }

  .system .vectors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }

  .library-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; margin-top: 32px; }
  .preview { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 28px; }
  .preview-title { font-family: var(--font-serif); font-size: 18px; color: var(--text); margin-bottom: 10px; }
  .preview-desc { color: var(--text-mute); font-size: 14px; line-height: 1.6; margin: 0; }
  .library-ctas { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .library-ctas a { display: inline-block; }

  .for-developers .dev-blocks { margin-top: 28px; }

  @media (max-width: 760px) {
    .hero { padding: 64px 22px 56px; }
    h1 { font-size: 38px; }
    .ctas { align-items: stretch; flex-direction: column; margin-bottom: 40px; }
    section.problem, section.system, section.library, section.for-developers { padding: 48px 22px; }
    .system .vectors { grid-template-columns: 1fr; }
    .library-grid { grid-template-columns: 1fr; }
  }
</style>
