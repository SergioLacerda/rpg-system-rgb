---
import VectorCard from "./VectorCard.astro";
import CodeBlock from "./CodeBlock.astro";
import { dict, type Locale } from "../i18n/dictionary";
import { landingPath } from "../lib/paths";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = dict[lang];
const a11y = t.a11y;
const pdfHref = landingPath(`/downloads/rgb-system-core-v2-latest-${lang}.pdf`);
---

<nav class="dot-nav" aria-label="Seções da página">
  <a href="#hero" data-dot="hero" aria-label={a11y.sectionNav.hero}></a>
  <a href="#problem" data-dot="problem" aria-label={a11y.sectionNav.problem}
  ></a>
  <a href="#system" data-dot="system" aria-label={a11y.sectionNav.system}></a>
  <a href="#library" data-dot="library" aria-label={a11y.sectionNav.library}
  ></a>
  <a
    href="#for-developers"
    data-dot="for-developers"
    aria-label={a11y.sectionNav.forDevelopers}></a>
</nav>

<div class="scroller">
<section class="hero" id="hero">
  <div class="kicker">{t.hero.kicker}</div>
  <h1>{t.hero.title}</h1>
  <p class="sub">{t.hero.sub}</p>
  <div class="ctas">
    <a class="primary" href={landingPath("/library/")}>{t.hero.ctaLibrary}</a>
    <a class="secondary" href={pdfHref}>{t.hero.ctaPdf}</a>
  </div>
  <svg width="220" height="200" viewBox="0 0 180 170" class="glyph">
    <polygon
      points="90,20 150,120 30,120"
      fill="none"
      stroke="var(--text)"
      stroke-width="1.5"
      opacity="0.5"></polygon>
    <line x1="90" y1="88" x2="140" y2="45" stroke="var(--r)" stroke-width="2"
    ></line>
    <line x1="90" y1="88" x2="40" y2="45" stroke="var(--b)" stroke-width="2"
    ></line>
    <line x1="90" y1="88" x2="90" y2="150" stroke="var(--g)" stroke-width="2"
    ></line>
    <circle cx="90" cy="88" r="4" fill="var(--text)"></circle>
  </svg>
  <a href="#problem" class="scroll-hint" aria-label={a11y.scrollHint}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
</section>

<section class="problem" id="problem">
  <a href="#hero" class="scroll-hint scroll-hint-up" aria-label={a11y.scrollHintPrev}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M18 15l-6-6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
  <div class="kicker">{t.problem.kicker}</div>
  <h2>{t.problem.title}</h2>
  <ul>
    {t.problem.items.map((item) => <li>{item}</li>)}
  </ul>
  <a href="#system" class="scroll-hint" aria-label={a11y.scrollHint}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
</section>

<section class="system" id="system">
  <a href="#problem" class="scroll-hint scroll-hint-up" aria-label={a11y.scrollHintPrev}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M18 15l-6-6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
  <div class="kicker">{t.system.kicker}</div>
  <h2>{t.system.title}</h2>
  <p class="sub">{t.system.desc}</p>
  <div class="vectors">
    {
      t.vectors.map((v) => (
        <VectorCard
          code={v.code}
          label={v.label}
          title={v.title}
          desc={v.desc}
        />
      ))
    }
  </div>
  <a href="#library" class="scroll-hint" aria-label={a11y.scrollHint}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
</section>

<section class="library" id="library">
  <a href="#system" class="scroll-hint scroll-hint-up" aria-label={a11y.scrollHintPrev}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M18 15l-6-6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
  <div class="kicker">{t.libraryTeaser.kicker}</div>
  <h2>{t.libraryTeaser.title}</h2>
  <p class="sub">{t.libraryTeaser.desc}</p>
  <div class="library-grid">
    <div class="preview">
      <div class="preview-title">{t.libraryTeaser.previewTitle}</div>
      <p class="preview-desc">{t.libraryTeaser.previewDesc}</p>
    </div>
    <div class="library-ctas">
      <a class="primary" href={landingPath("/library/")}
        >{t.libraryTeaser.cta}</a
      >
      <a class="secondary" href={pdfHref}>{t.hero.ctaPdf}</a>
    </div>
  </div>
  <a href="#for-developers" class="scroll-hint" aria-label={a11y.scrollHint}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
</section>

<section class="for-developers" id="for-developers">
  <a href="#library" class="scroll-hint scroll-hint-up" aria-label={a11y.scrollHintPrev}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
      ><path
        d="M18 15l-6-6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </a>
  <div class="kicker">{t.forDevelopers.kicker}</div>
  <h2>{t.forDevelopers.title}</h2>
  <p class="sub">{t.forDevelopers.desc}</p>
  <div class="dev-blocks">
    {
      t.forDevelopers.items.map((item) => (
        <CodeBlock label={item.label} code={item.code} />
      ))
    }
  </div>
</section>
</div>

<script>
  const dots = document.querySelectorAll<HTMLAnchorElement>(".dot-nav a");
  const sections = document.querySelectorAll<HTMLElement>(".scroller > section");
  const scroller = document.querySelector<HTMLElement>(".scroller");

  // .scroller has its own overflow-y scroll for section snapping, but the
  // outer document is *also* scrollable (so the footer, which sits below
  // .scroller, stays reachable). Native anchor-jump / :target navigation
  // scrolls every scrollable ancestor it can reach, not just .scroller —
  // which nudges the outer document too and shifts .scroller up behind the
  // sticky header. Section-nav links are handled manually instead, moving
  // only .scroller and resetting the outer document scroll.
  function scrollToSection(id: string) {
    const target = document.getElementById(id);
    if (!scroller || !target) return;
    const delta = target.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
    scroller.scrollTop += delta;
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;
  }

  document
    .querySelectorAll<HTMLAnchorElement>(".scroll-hint, .dot-nav a")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.getAttribute("href")?.slice(1);
        if (!id) return;
        event.preventDefault();
        scrollToSection(id);
        history.replaceState(null, "", `#${id}`);
      });
    });

  if (location.hash) {
    // A page loaded directly with a section hash (deep link/reload) has the
    // same conflict as a click: the browser's own fragment navigation can
    // run *after* this script (observed around/after the "load" event) and
    // override the correction below. Strip the hash immediately so the
    // browser has nothing to re-scroll to later, and re-apply our own
    // correction once more on "load" as a safety net.
    const initialId = location.hash.slice(1);
    history.replaceState(null, "", location.pathname + location.search);
    scrollToSection(initialId);
    window.addEventListener("load", () => {
      scrollToSection(initialId);
      history.replaceState(null, "", `#${initialId}`);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          dots.forEach((d) =>
            d.classList.toggle(
              "active",
              d.getAttribute("href") === `#${entry.target.id}`,
            ),
          );
        }
      });
    },
    { threshold: 0.5 },
  );
  sections.forEach((s) => observer.observe(s));
</script>

<style>
  .scroller {
    scroll-snap-type: y proximity;
    overflow-y: auto;
    height: calc(100vh - var(--header-h, 82px));
  }
  .scroller > section {
    scroll-snap-align: start;
    min-height: calc(100vh - var(--header-h, 82px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  .scroller > section.for-developers {
    height: auto;
  }

  .scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-mute);
    display: flex;
  }
  .scroll-hint:hover {
    color: var(--text);
  }
  .scroll-hint-up {
    top: 28px;
    bottom: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-hint {
      animation: bob 1.8s ease-in-out infinite;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 6px);
    }
  }

  .dot-nav {
    position: fixed;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 20;
  }
  .dot-nav a {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
    border: 1px solid var(--text-mute);
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .dot-nav a.active {
    background: var(--b);
    border-color: var(--b);
    transform: scale(1.3);
  }

  @media (max-height: 560px) {
    .scroller {
      scroll-snap-type: none;
      height: auto;
      overflow-y: visible;
    }
    .scroller > section {
      min-height: auto;
    }
  }

  .hero {
    text-align: center;
    padding: 100px 40px 80px;
    background: radial-gradient(
      circle at 50% 20%,
      var(--surface) 0%,
      var(--bg) 60%
    );
  }
  .kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--text-dim);
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 56px;
    color: var(--text);
    margin: 0 0 20px;
    line-height: 1.15;
  }
  .sub {
    font-size: 17px;
    color: var(--text-dim);
    max-width: 560px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }
  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-bottom: 60px;
  }
  .primary {
    background: var(--text);
    color: var(--bg);
    padding: 13px 26px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .secondary {
    border: 1px solid #2a3350;
    color: var(--text);
    padding: 13px 26px;
    border-radius: 6px;
    font-size: 14px;
  }
  .glyph {
    display: block;
    margin: 0 auto;
  }

  section.problem,
  section.system,
  section.library,
  section.for-developers {
    padding: 72px 40px;
    max-width: 920px;
    margin: 0 auto;
  }
  section.problem h2,
  section.system h2,
  section.library h2,
  section.for-developers h2 {
    font-family: var(--font-serif);
    font-size: 32px;
    color: var(--text);
    margin: 0 0 16px;
  }

  .problem ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 14px;
  }
  .problem li {
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.6;
    padding-left: 22px;
    position: relative;
  }
  .problem li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--r);
  }

  .system .vectors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .library-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
    margin-top: 32px;
  }
  .preview {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 28px;
  }
  .preview-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--text);
    margin-bottom: 10px;
  }
  .preview-desc {
    color: var(--text-mute);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .library-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .library-ctas a {
    display: inline-block;
  }

  .for-developers .dev-blocks {
    margin-top: 28px;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 64px 22px 56px;
    }
    h1 {
      font-size: 38px;
    }
    .ctas {
      align-items: stretch;
      flex-direction: column;
      margin-bottom: 40px;
    }
    section.problem,
    section.system,
    section.library,
    section.for-developers {
      padding: 48px 22px;
    }
    .system .vectors {
      grid-template-columns: 1fr;
    }
    .library-grid {
      grid-template-columns: 1fr;
    }
    .dot-nav {
      right: 12px;
    }
  }
</style>
